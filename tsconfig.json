{
  "compilerOptions": {
    "outDir": "./dist",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ESNext",
    "strict": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    /* Chequeo de variables y parámetros no usados */
    "noUnusedLocals": false ,
    "noUnusedParameters": true
  },
  "include": ["src/**/*", "test/**/*", "vitest.config.ts"]
}